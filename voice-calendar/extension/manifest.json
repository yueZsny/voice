{
  "manifest_version": 3,
  "name": "语音日历",
  "version": "1.0.0",
  "description": "说一句话，轻松管理日程 — 本地语音日历 Chrome 扩展",
  "action": {
    "default_title": "语音日历 — 打开侧边栏",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "host_permissions": [
    "http://localhost:3001/*",
    "ws://localhost:3001/*"
  ],
  "permissions": [
    "sidePanel"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
